<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Branch on the invoice, so spend and revenue can be reported per
         emirate. Customer invoices fill it from the source order; a vendor
         bill needs a person to say which branch the cost belongs to. -->
    <record id="view_move_form_branch" model="ir.ui.view">
        <field name="name">account.move.form.exec.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="branch_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
