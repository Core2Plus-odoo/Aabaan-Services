<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Graft the FM domain fields onto the native Field Service task form. -->
    <record id="view_fsm_task_form_fm" model="ir.ui.view">
        <field name="name">project.task.form.fm.fsm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="fm_asset_id"/>
                <field name="fm_contract_order_id"/>
                <field name="fm_service_line"/>
                <field name="fm_severity"/>
                <field name="fm_wo_type"/>
                <field name="fm_time_slot"/>
                <field name="fm_has_service_document"/>
            </xpath>
        </field>
    </record>

    <!-- The guarded execution flow: three buttons and the field report they
         write. The buttons are the easy path and the correct path; dragging
         a card to In Progress, Completed or Cancelled is intercepted in
         project.task.write() with a message naming the button to use.

         Guarded on fm_is_fsm because this view inherits the ordinary project
         task form: an office task must not sprout a Start Visit button.

         The fields the button conditions read live on the Field Report tab
         below — a field only has to be somewhere in the view, not before
         its first use. -->
    <record id="view_fsm_task_form_fm_execution" model="ir.ui.view">
        <field name="name">project.task.form.fm.execution</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="fm_is_fsm" invisible="1"/>
                <button name="action_fm_start_visit" type="object" class="btn-primary"
                        string="Start Visit"
                        invisible="not fm_is_fsm or fm_visit_started_at or fm_visit_completed_at"/>
                <button name="action_fm_complete_visit" type="object" class="btn-primary"
                        string="Complete Visit"
                        invisible="not fm_is_fsm or not fm_visit_started_at or fm_visit_completed_at"/>
                <button name="action_fm_cancel_visit" type="object"
                        string="Cancel Visit"
                        invisible="not fm_is_fsm or fm_visit_completed_at"/>
            </xpath>
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Field Report" name="fm_field_report" invisible="not fm_is_fsm">
                    <group>
                        <group string="On Site">
                            <field name="fm_visit_started_at"/>
                            <field name="fm_visit_completed_at"/>
                            <field name="fm_visit_duration_actual" widget="float_time"/>
                            <field name="fm_sla_escalated"/>
                        </group>
                        <group string="Follow-up">
                            <field name="fm_infestation_found"/>
                            <field name="fm_followup_task_id"/>
                            <field name="fm_followup_origin_id"
                                   invisible="not fm_followup_origin_id"/>
                        </group>
                    </group>
                    <group string="Work Carried Out">
                        <field name="fm_treatment_summary" nolabel="1" colspan="2"
                               placeholder="Areas treated and work done — the municipality return is written from this."/>
                    </group>
                    <group string="Chemicals / Materials Used">
                        <field name="fm_chemicals_used" nolabel="1" colspan="2"
                               placeholder="Product and quantity, as the municipality return requires."/>
                    </group>
                    <group string="Cancellation" invisible="fm_visit_completed_at">
                        <field name="fm_cancel_reason" nolabel="1" colspan="2"
                               placeholder="Required before a visit can be cancelled."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Visit calendar: auto-scheduled and reactive FM work orders by date.
         Coloured by status (stage), keyed on the visit date (date_deadline).
         Each event shows the customer/site as its title (see the visit name
         in the shared generator, fm.visit.schedule.mixin), with asset,
         technician, service line and status in the popup. -->
    <record id="view_fm_task_calendar" model="ir.ui.view">
        <field name="name">project.task.calendar.fm</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar string="Visit Calendar" date_start="date_deadline"
                      color="stage_id" mode="month" quick_create="0"
                      event_open_popup="1">
                <field name="partner_id" filters="1"/>
                <field name="stage_id" filters="1"/>
                <field name="fm_service_line" filters="1"/>
                <field name="fm_asset_id"/>
                <field name="fm_contract_order_id"/>
                <field name="fm_severity"/>
                <field name="user_ids" widget="many2many_avatar_user" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Group / filter the FSM list &amp; calendar by the FM dimensions. -->
    <record id="view_fsm_task_search_fm" model="ir.ui.view">
        <field name="name">project.task.search.fm.fsm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="fm_not_started" string="Past Plan, Not Started"
                        domain="[('fm_visit_started_at', '=', False),
                                 ('stage_id.fold', '=', False)]"/>
                <filter name="fm_escalated" string="Escalated"
                        domain="[('fm_sla_escalated', '=', True)]"/>
                <separator/>
                <filter name="fm_group_customer" string="Customer"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="fm_group_stage" string="Status"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="fm_group_service_line" string="Service Line"
                        context="{'group_by': 'fm_service_line'}"/>
                <filter name="fm_group_severity" string="Severity"
                        context="{'group_by': 'fm_severity'}"/>
                <filter name="fm_group_technician" string="Technician"
                        context="{'group_by': 'user_ids'}"/>
                <filter name="fm_group_time_slot" string="Time Slot"
                        context="{'group_by': 'fm_time_slot'}"/>
                <separator/>
                <filter name="fm_awaiting_documents" string="Awaiting Documents"
                        domain="[('fm_has_service_document', '=', False)]"/>
                <filter name="fm_group_contract" string="AMC Contract"
                        context="{'group_by': 'fm_contract_order_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
