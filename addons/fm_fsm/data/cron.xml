<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Kept a rolling horizon of planned FSM visits populated for active,
         auto-scheduled fm.contract records.

         SHIPPED INACTIVE, deliberately.

         CORRECTION to what this comment said when the cron was switched off:
         it named sale.order._generate_visit_schedule() (aabaan_visit_schedule)
         as a second generator running "on this platform". That module is in
         the separate Core2Plus-odoo/aabaan repository, deployed to a
         different Odoo.sh instance, so the two do not in fact collide on
         this database. Only this cron generates visits here.

         The reason to leave it off stands on its own. Contracts are written
         in Sales now, and visits are being re-pointed to follow the sale
         order rather than fm.contract, which is frozen and on its way out.
         This cron reads fm.contract and runs unattended every day: while the
         re-point is in flight it would generate visits from the model being
         retired, against contracts nobody can create, with nothing on screen
         to say why.

         Re-enabling it is a two-minute job from Settings > Technical >
         Scheduled Actions if the direction ever changes, but read the above
         first: visits appear with nothing on screen to say what made them. -->
    <record id="cron_fm_fsm_auto_schedule" model="ir.cron">
        <field name="name">FM: Auto-schedule Field Service visits (retired)</field>
        <field name="model_id" ref="fm_contract.model_fm_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_schedule()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
