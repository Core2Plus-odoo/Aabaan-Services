<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fm_create_job_wizard" model="ir.ui.view">
        <field name="name">fm.create.job.wizard.form</field>
        <field name="model">fm.create.job.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Job">
                <group>
                    <group>
                        <field name="order_id" string="Contract"/>
                        <field name="partner_id" string="Customer"/>
                        <field name="job_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <label for="duration"/>
                        <div class="o_row">
                            <field name="duration" class="oe_inline" style="max-width: 5rem;"/>
                            <field name="duration_unit" class="oe_inline" required="1"/>
                        </div>
                        <field name="end_date"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="line_ids">
                    This contract has no service line (goods are not jobs). Close this, add
                    the services on the contract's <b>Order Lines</b>, then press Create Job again.
                </div>
                <div class="text-muted small mb-2" invisible="not line_ids or job_type != 'recurring'">
                    Set each service's frequency: <b>4 per Year</b> = 4 jobs a year, one every
                    3 months; <b>2 per Month</b> = 2 jobs a month, 15 days apart. Tick
                    <b>Every</b> for "every N": <b>Every 3 Month</b> = one job every 3 months.
                    Untick <b>Create Job</b> for a fee or charge that is not a visit.
                </div>
                <div class="text-muted small mb-2" invisible="not line_ids or job_type != 'one_off'">
                    One Off: one job for each ticked service, on the Start Date.
                </div>
                <field name="line_ids" nolabel="1" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="create_job" string="Create Job"/>
                        <field name="sale_line_id" string="Service" options="{'no_open': True}" force_save="1"/>
                        <field name="every" column_invisible="parent.job_type != 'recurring'"
                               readonly="not create_job"/>
                        <field name="count" column_invisible="parent.job_type != 'recurring'"
                               readonly="not create_job"/>
                        <field name="unit" column_invisible="parent.job_type != 'recurring'"
                               readonly="not create_job" required="create_job"/>
                        <field name="job_count"/>
                        <field name="dates_preview"/>
                    </list>
                </field>
                <div class="text-muted">
                    <b><field name="job_count" class="oe_inline"/> job(s)</b> will be put on the
                    Maintenance Calendar. The plan is saved on the contract and its lines,
                    and the contract becomes Approved.
                </div>
                <footer>
                    <button name="action_create_jobs" type="object" string="Create Jobs"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
