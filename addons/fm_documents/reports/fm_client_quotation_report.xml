<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Aaban's own quotation, printed the way the client writes it.

         Used by the Quotation report (report_fm_quotation_document) for an
         order whose quotation template is a Client Quotation Layout: the
         order's quotation wording IS the document, in order; the priced
         lines, the totals box and the total in words print where a Price
         Table line sits. The letterhead is the company's
         (report_qweb_pdf_watermark), so this page draws none of its own. -->
    <template id="report_fm_client_quotation_page">
        <t t-call="web.external_layout">
            <t t-set="customer" t-value="o.partner_id.commercial_partner_id"/>
            <t t-set="contact" t-value="o._fm_client_contact()"/>
            <t t-set="values" t-value="o._fm_quote_values()"/>
            <div class="page" style="font-family:Roboto,Arial,Helvetica,sans-serif;font-size:10pt;line-height:1.5;color:#000;">

                <!-- Who it is for (left), the document box (right). A grid, not
                     a table: the report stylesheet borders tables. -->
                <div class="row" style="margin-bottom:12px;">
                    <div class="col-7" style="line-height:1.3;">
                        <t t-if="o.fm_quote_company_block">
                            <t t-set="company" t-value="o.company_id"/>
                            <div style="font-size:11.5pt;font-weight:bold;">M/s. <t t-out="company.name"/></div>
                            <div t-if="company.street" t-out="company.street"/>
                            <div t-if="company.city or company.state_id" t-out="', '.join(p for p in (company.city, company.state_id.name) if p)"/>
                            <div t-if="company.email" t-out="company.email"/>
                            <div t-if="company.phone" t-out="company.phone"/>
                            <div t-if="company.vat">TRN: <t t-out="company.vat"/></div>
                        </t>
                        <div style="font-size:11.5pt;font-weight:bold;"><t t-if="o.fm_client_title"><t t-out="o.fm_client_title"/> </t><t t-out="customer.name"/></div>
                        <div t-if="customer.street" t-out="customer.street"/>
                        <div t-if="customer.street2" t-out="customer.street2"/>
                        <div t-if="customer.city or customer.state_id" t-out="', '.join(p for p in (customer.city, customer.state_id.name) if p)"/>
                        <div t-if="customer.email" t-out="customer.email"/>
                        <div t-if="customer.phone" t-out="customer.phone"/>
                        <div t-if="customer.vat">TRN: <t t-out="customer.vat"/></div>
                        <t t-if="contact">
                            <div style="margin-top:12px;"><b><i>Contact Person</i></b></div>
                            <div t-out="contact.name"/>
                            <div t-if="contact.function" t-out="contact.function"/>
                            <div t-if="contact.email" t-out="contact.email"/>
                            <div t-if="contact.phone" t-out="contact.phone"/>
                        </t>
                    </div>
                    <div class="col-5">
                        <div style="text-align:right;font-size:15pt;font-weight:bold;margin-bottom:6px;">Quotation</div>
                        <table style="width:100%;border-collapse:collapse;border:1px solid #e3e3e3;font-weight:bold;">
                            <tr style="background:#ffdfcf;">
                                <td style="padding:6px 8px;color:#f47b20;border:none;">Ref#</td>
                                <td style="padding:6px 8px;color:#f47b20;text-align:right;border:none;" t-out="o._fm_client_reference()"/>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px;border:none;border-top:1px solid #e3e3e3;">Date</td>
                                <td style="padding:6px 8px;text-align:right;border:none;border-top:1px solid #e3e3e3;" t-out="o._fm_client_date(o.date_order)"/>
                            </tr>
                            <tr t-if="o.validity_date" style="background:#fff1ea;">
                                <td style="padding:6px 8px;border:none;border-top:1px solid #e3e3e3;">Valid Until</td>
                                <td style="padding:6px 8px;text-align:right;border:none;border-top:1px solid #e3e3e3;" t-out="o._fm_client_date(o.validity_date)"/>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="o.subject" style="margin-bottom:10px;">
                    <b>Subject: </b><i t-out="o.subject"/>
                </div>

                <t t-foreach="o.fm_quote_line_ids" t-as="qline">
                    <t t-if="qline.kind == 'price_table'">
                        <t t-call="fm_documents.report_fm_client_quotation_table"/>
                    </t>
                    <div t-else="" t-out="o._fm_render_agreement_html(qline.body_html, values)"/>
                </t>
            </div>
        </t>
    </template>

    <!-- The priced lines as the client's quotation prints them, then the
         totals box and the total in words. A note line on the order prints
         as a row of its own, under Description. -->
    <template id="report_fm_client_quotation_table">
        <t t-set="cols" t-value="o._fm_quote_columns()"/>
        <t t-set="year" t-value="' For 1 Year' if o.fm_quote_per_year else ''"/>
        <t t-set="th" t-value="'padding:10px 6px;text-align:center;border:1px solid #f9b88c;'"/>
        <t t-set="td" t-value="'padding:8px 6px;vertical-align:top;border:1px solid #e3e3e3;'"/>
        <table style="width:100%;border-collapse:collapse;margin-top:12px;border:1px solid #e3e3e3;">
            <thead>
                <tr style="background:#f57f27;color:#fff;font-weight:bold;">
                    <th t-att-style="th + 'width:5%;'"/>
                    <th t-att-style="th">Description</th>
                    <th t-if="'unit' in cols" t-att-style="th + 'width:7%;'">Unit</th>
                    <th t-if="'frequency' in cols" t-att-style="th + 'width:12%;white-space:nowrap;'">Frequency</th>
                    <th t-if="'subtotal' in cols" t-att-style="th + 'width:14%;white-space:nowrap;'">Subtotal<t t-out="year"/></th>
                    <th t-if="'summary' in cols" t-att-style="th + 'width:27%;'">Summary</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="number" t-value="0"/>
                <t t-foreach="o.order_line.filtered(lambda l: l.display_type != 'line_section')" t-as="line">
                    <tr t-att-style="'page-break-inside:avoid;' + ('background:#fff1ea;' if line_index % 2 else '')">
                        <t t-if="line.display_type">
                            <td t-att-style="td"/>
                            <td t-att-style="td">
                                <div t-if="line.fm_print_details" t-out="line.fm_print_details"/>
                                <div t-else="" style="white-space:pre-wrap;" t-out="line.name"/>
                            </td>
                            <td t-if="'unit' in cols" t-att-style="td"/>
                            <td t-if="'frequency' in cols" t-att-style="td"/>
                            <td t-if="'subtotal' in cols" t-att-style="td"/>
                            <td t-if="'summary' in cols" t-att-style="td"/>
                        </t>
                        <t t-else="">
                            <t t-set="number" t-value="number + 1"/>
                            <t t-set="desc" t-value="(line.name or '').split('\n')"/>
                            <td t-att-style="td" t-out="number"/>
                            <td t-att-style="td">
                                <b t-out="o._fm_client_line_title(desc[0])"/>
                                <div t-if="line.fm_print_details" t-out="line.fm_print_details"/>
                                <t t-else=""><t t-foreach="desc[1:]" t-as="dl"><div t-out="dl"/></t></t>
                            </td>
                            <td t-if="'unit' in cols" t-att-style="td + 'text-align:center;'"
                                t-out="'%g' % (line.fm_print_unit or line.product_uom_qty)"/>
                            <td t-if="'frequency' in cols" t-att-style="td + 'text-align:center;white-space:nowrap;'"
                                t-out="line.fm_print_frequency or ''"/>
                            <td t-if="'subtotal' in cols" t-att-style="td + 'text-align:right;'"
                                t-out="o._fm_client_money(line.price_subtotal)"/>
                            <td t-if="'summary' in cols" t-att-style="td + 'padding:2px 6px;'">
                                <t t-set="sc" t-value="'padding:5px 0;border:none;border-bottom:1px dashed #d9d9d9;'"/>
                                <table style="width:100%;border-collapse:collapse;border:none;">
                                    <tr><td t-att-style="sc">Total Units<t t-out="year"/></td><td t-att-style="sc + 'text-align:right;'" t-out="'%g' % line.product_uom_qty"/></tr>
                                    <tr><td t-att-style="sc">Subtotal<t t-out="year"/></td><td t-att-style="sc + 'text-align:right;'" t-out="o._fm_client_money(line.price_subtotal)"/></tr>
                                    <tr><td t-att-style="sc">Tax</td><td t-att-style="sc + 'text-align:right;'" t-out="o._fm_client_money(line.price_tax)"/></tr>
                                    <tr><td t-att-style="sc">Grand Total</td><td t-att-style="sc + 'text-align:right;'" t-out="o._fm_client_money(line.price_total)"/></tr>
                                </table>
                            </td>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
        <div class="row" style="margin-top:14px;page-break-inside:avoid;">
            <div class="col-6 offset-6">
                <t t-set="bx" t-value="'padding:7px 10px;font-weight:bold;border:none;border-top:1px solid #e3e3e3;'"/>
                <table style="width:100%;border-collapse:collapse;border:1px solid #e3e3e3;">
                    <tr style="background:#fff1ea;"><td t-att-style="bx">Subtotal<t t-out="year"/></td><td t-att-style="bx + 'text-align:right;'" t-out="o._fm_client_money(o.amount_untaxed)"/></tr>
                    <tr style="background:#fff1ea;"><td t-att-style="bx">VAT 5%</td><td t-att-style="bx + 'text-align:right;'" t-out="o._fm_client_money(o.amount_tax)"/></tr>
                    <tr style="background:#f57f27;color:#fff;"><td t-att-style="bx">Grand Total</td><td t-att-style="bx + 'text-align:right;'" t-out="o._fm_client_money(o.amount_total)"/></tr>
                </table>
            </div>
        </div>
        <div style="margin-top:12px;font-weight:bold;font-style:italic;">
            Total Amount <t t-out="o.currency_id.name"/> <t t-out="o._fm_client_money(o.amount_total)"/>
            (<t t-out="o._fm_client_amount_in_words()"/>)
        </div>
    </template>

</odoo>
