<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Document Audit Trail, as a tab on the invoice.

         Anchored on //sheet//notebook rather than //notebook: the bare
         path attaches to whichever notebook comes first in the arch, and
         account.view_move_form is large enough that "first" is not a
         promise. This exact xpath is the one that loaded on Odoo 19's
         account.view_move_form on the build this was ported from.

         The page is hidden rather than absent for a vendor bill, because
         the field computes to False there and an empty tab labelled
         "Document Audit Trail" on a supplier invoice reads as a fault. -->
    <record id="view_move_form_fm_audit_trail" model="ir.ui.view">
        <field name="name">account.move.form.fm.audit.trail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//notebook" position="inside">
                <page string="Document Audit Trail" name="fm_audit_trail"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="fm_audit_trail_html" widget="html" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
