<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ===================================================================
         The Command Centre carries revenue, margin, cash and receivables,
         so it has its own group rather than riding on an FM role: the
         module is standalone now and must be installable, and grantable,
         without the FM suite.

         Odoo 19: res.groups has no category_id — groups attach to a
         res.groups.privilege, which carries the module category.
         =================================================================== -->

    <record id="module_category_command_centre" model="ir.module.category">
        <field name="name">Command Centre</field>
        <field name="description">Access to the executive Command Centre</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_command_centre" model="res.groups.privilege">
        <field name="name">Command Centre</field>
        <field name="category_id" ref="module_category_command_centre"/>
    </record>

    <record id="group_command_centre_viewer" model="res.groups">
        <field name="name">Command Centre Viewer</field>
        <field name="privilege_id" ref="privilege_command_centre"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Somebody has to be able to open it on the day it is installed.
         Settings administrators can then grant it to the executives. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_command_centre_viewer'))]"/>
    </record>

</odoo>
