<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_command_centre" model="ir.actions.client">
        <field name="name">Command Centre</field>
        <field name="tag">fm_command_centre</field>
    </record>

    <!-- Its own app, not a menu inside Facility Management.

         The Command Centre is the executive view of the whole business —
         sales, finance, expenses, cash and renewals, not just facility
         management — and it is installable without the FM suite. Burying
         it under the FM app made it look like an FM report and tied its
         visibility to an FM role. It is now a root menu of its own, which
         is also what "one command centre" means in practice: the two older
         dashboards that sat beside it under FM are retired.

         No web_icon: a file path in that field crashes on this build
         (see fm_asset/views/menus.xml); the default app icon is used. -->
    <menuitem id="menu_command_centre_root"
              name="Command Centre"
              action="action_command_centre"
              sequence="5"
              groups="fm_command_centre.group_command_centre_viewer"/>

</odoo>
