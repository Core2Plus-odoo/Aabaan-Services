<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One tick on the product is what makes a sale an FM contract.
         Placed on General Information rather than behind a tab: it changes
         what happens when an order containing the product is confirmed, so
         it belongs where someone setting the product up will see it. -->
    <record id="view_product_template_form_fm_contract" model="ir.ui.view">
        <field name="name">product.template.form.fm.contract</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']"
                   position="inside">
                <field name="fm_is_contract_service"
                       groups="fm_branding.group_fm_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
